#!/usr/bin/make -f

VERSION=1.95.0

%:
	dh $@

override_dh_auto_clean:
	ischroot || bash fetch.sh upstream $(VERSION) \
		2e0338f18ecbaa4a0f631b9e80e8b8e26bb6fe77dd5454fba8a70cf96c1e84a1 \
		094c9c36531911c5cc7dd6ab2d3069ab8dcd744d6239b0bda1387b243dfc391e

override_dh_auto_build:
	just version=$(VERSION)

override_dh_auto_install:
	just version=$(VERSION) rootdir=debian/tmp install
	patchelf --add-needed /usr/lib/rustlib/$(DEB_TARGET_GNU_CPU)-unknown-linux-gnu/lib/libLLVM.so.22.1-rust-$(VERSION)-stable  debian/tmp/usr/bin/cargo-clippy; \
	patchelf --add-needed /usr/lib/rustlib/$(DEB_TARGET_GNU_CPU)-unknown-linux-gnu/lib/libLLVM.so.22.1-rust-$(VERSION)-stable  debian/tmp/usr/bin/clippy-driver; \
	patchelf --add-needed /usr/lib/rustlib/$(DEB_TARGET_GNU_CPU)-unknown-linux-gnu/lib/libLLVM.so.22.1-rust-$(VERSION)-stable  debian/tmp/usr/bin/rustc; \
	patchelf --add-needed /usr/lib/rustlib/$(DEB_TARGET_GNU_CPU)-unknown-linux-gnu/lib/libLLVM.so.22.1-rust-$(VERSION)-stable  debian/tmp/usr/bin/rustfmt; \

override_dh_strip:

override_dh_shlibdeps:
	# dh_shlibdeps -Xclippy -l/usr/lib/rustlib/$(DEB_TARGET_GNU_CPU)-unknown-linux-gnu/lib/
